{
    "java.configuration.updateBuildConfiguration": "interactive",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/modules/**": true,
        "**/node_modules/**": true,
        "**/.pnpm/**": true,
        "**/.expo/**": true,
        "**/.gradle/**": true,
        "**/.kotlin/**": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/web-build/**": true,
        "**/out/**": true,
        "**/coverage/**": true
    },
    "files.watcherFollowSymlinks": false,
    "search.followSymlinks": false
}